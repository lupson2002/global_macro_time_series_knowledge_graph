# ============================================================
# global_macro_time_series_knowledge_graph — 환경변수 템플릿
# 실제 값은 .env (gitignore)에 채워서 사용. 복사: cp .env.example .env
# ============================================================

# ── NIM fallback / model overrides ──
NIM_BASE_URL=http://localhost:8000
NIM_API_KEY=proxy-rotates-keys
TIER2_MODEL=deepseek-ai/deepseek-v4-flash
TIER3_MODEL=deepseek-ai/deepseek-v4-flash
INSIGHT_MODEL=deepseek-ai/deepseek-v4-flash
LLM_TIMEOUT=300
TIER2_TIMEOUT=300
BLOG_TIMEOUT=180
NARRATIVE_MAX_TOKENS=8192

# ── Llama70BRouter (Cerebras 1 + Groq 2, NIM 폴백) ──
# Llama 3.3 70B 등급 작업(번역/블로그)용. 미설정 시 해당 단계 생략 + NIM 폴백.
CEREBRAS_API_KEY=                     # https://api.cerebras.ai/v1 (llama-3.3-70b)
GROQ_API_KEY_1=                       # https://api.groq.com/openai/v1 (llama-3.3-70b-versatile)
GROQ_API_KEY_2=

# ── 임베딩 (NIM nv-embed-v1, OpenAI 호환 /embeddings) ──
EMBEDDING_API_URL=http://localhost:8000/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nv-embed-v1
EMBEDDING_DIM=4096
# EMBEDDING_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── YouTube ──
YOUTUBE_PROXY=
YOUTUBE_COOKIES_FILE=cookies.txt

# ── Email (리포트 발송) ──
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_app_password
EMAIL_TO=you@gmail.com,other@naver.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── Telegram (선택) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MCP_TRANSPORT=inproc
MAX_TOOL_ITER=6
OLLAMA_TIMEOUT_S=120
LOG_LEVEL=INFO

# ── 구조화 실행 기록 (선택, 비우면 래퍼 동작 변화 없음) ──
PIPELINE_EVENT_LOG=

# ── Ollama Cloud (LLM 메인 백엔드 — NIM 보조) ──
OLLAMA_PRO_API_KEY=your_ollama_api_key
OLLAMA_PRO_BASE_URL=https://ollama.com/v1
OLLAMA_PRO_MODEL=deepseek-v4-flash:0731-cloud
